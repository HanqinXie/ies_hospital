+    a=p.parse_args()
+    if a.mode=='verify':return 0 if verify()['status']=='passed' else 1
+    if a.mode=='stage':return stage(a.destination)
+    return reproduce(a.name)
+
+if __name__=='__main__':raise SystemExit(main())
