+def build_zone_groups(zone_df:pd.DataFrame, hourly:pd.DataFrame)->pd.DataFrame:
+    """Conservative V20 field-specific priority decomposition of original totals.
+
+    Zone proxies are not added to building totals. The existing thermal clipping,
+    proportional compression algorithm and P3 residual algorithm are retained;
+    grouping_diagnostics exposes every carrier's values before compression.
+    """
+    _,_,_,_,values=_zone_group_arrays(zone_df,hourly)
     out=pd.DataFrame({'hour_of_year':hourly.hour_of_year.to_numpy()})
     for i,g in enumerate(GROUPS):
         for j,k in enumerate(CARRIERS):out[f'{g}_{k}_kW']=values[:,i,j]
     return out
 
 
+def grouping_diagnostics(zone_df:pd.DataFrame, hourly:pd.DataFrame)->pd.DataFrame:
+    """Per-hour proxy accounting; no dispatch, extra clipping or load changes.
+
+    ``*_raw_kW`` means the existing nonnegative thermal proxy before any
+    proportional compression, not a new whole-building measurement. A positive
+    excess is retained even when allocation subsequently conserves the total.
+    """
+    data,total,summed,scale,values=_zone_group_arrays(zone_df,hourly)
+    out=pd.DataFrame({'hour_of_year':hourly.hour_of_year.to_numpy()})
+    for j,carrier in enumerate(CARRIERS):
+        for i in range(3):out[f'P{i}_{carrier}_raw_kW']=data[:,i,j]
+        out[f'{carrier}_proxy_sum_kW']=summed[:,j]
+        out[f'{carrier}_building_total_kW']=total[:,j]
+        out[f'{carrier}_compression_scale']=scale[:,j]
+        out[f'{carrier}_proxy_excess_kW']=np.maximum(0.,summed[:,j]-total[:,j])
+        out[f'{carrier}_compression_applied']=scale[:,j]<1.
+        out[f'{carrier}_P3_residual_kW']=values[:,3,j]
+    out.attrs['load_accounting_contract_id']=LOAD_ACCOUNTING_CONTRACT_ID
+    return out
+
