+        for p in PRIORITIES:
+            objective=np.zeros(model['nv'])
+            for c in CARRIERS:
+                denominator=norm['denominators_kWh'][p][c]
+                if denominator>0:
+                    for h in range(n):
+                        objective[V('unmet.'+p+'.'+c,h)]=_at(spec['duration_h'],h)/denominator
+            objectives.append((p,objective))
+    objectives.append(('fee',model['fee']))
